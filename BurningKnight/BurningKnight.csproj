<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Lens\Lens.csproj">
            <Project>{3b26aa2e-0ba2-42dc-ad62-e6c8617f9e4d}</Project>
            <Name>Lens</Name>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Extended" Version="4.0.4" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- ImGui is a development tool: a release build compiles out the editor halves and the dev
         UI, so nothing left references it. Debug keeps all of it (ADR-0003). -->
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <Compile Remove="**/*.Debug.cs" />
        <Compile Remove="ui/imgui/**/*.cs" />
        <Compile Remove="ui/editor/**/*.cs" />
        <Compile Remove="debug/**/*.cs" />
        <!-- the stubs that stand in for the dev windows a release build compiles out -->
        <Compile Include="ui/imgui/**/*.Release.cs" />
        <Compile Include="debug/**/*.Release.cs" />
        <Compile Remove="assets/ImGuiHelper.cs" />
        <Compile Remove="state/save/**/*.cs" />
        <Compile Remove="save/SaveDebug.cs" />
        <Compile Remove="state/EditorState.cs;state/RoomEditorState.cs;state/DialogEditorState.cs;state/PicoState.cs;state/AreaDebug.cs;state/ItemEditor*.cs;state/DevAssetLoadState.cs" />
    </ItemGroup>

    <!-- The stubs that stand in for the dev windows a release build compiles out. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <Compile Remove="**/*.Release.cs" />
    </ItemGroup>
</Project>