<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Lens\Lens.csproj">
            <Project>{3b26aa2e-0ba2-42dc-ad62-e6c8617f9e4d}</Project>
            <Name>Lens</Name>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Extended" Version="4.0.4" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <AnimationSource Include="Content/Animations/*.ase" />
        <AnimationSheet Include="Content/bin/Animations/*.png" />
        <AnimationSheet Include="Content/bin/Animations/animations.json" />
    </ItemGroup>

    <!-- The sheets are build output, cut from the .ase sources before anything loads them.
         Timestamps keep the preprocessor off the path when nothing changed. -->
    <Target Name="PreprocessAnimations" BeforeTargets="BeforeBuild"
            Inputs="@(AnimationSource)" Outputs="@(AnimationSheet)">
        <Exec Command="dotnet fsi &quot;$(MSBuildThisFileDirectory)../tools/preprocess-ase.fsx&quot;" />
    </Target>
</Project>