<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The pad is the point, but the game still installs on devices without one. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Gameplay rumble: normal permission, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- No cloud backup: Auto Backup would restore stale saves over the live ones. -->
    <application
        android:label="Burning Knight"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false" />
</manifest>
