<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <!-- ImGui is a development tool. A release build does not reference it, and every file
             that uses it — the editor halves (*.Debug.cs), the dev UI, the editors, the console,
             the debug windows and the save inspectors — is compiled out below (ADR-0003). -->
        <PackageReference Include="ImGui.NET" Version="1.89.9.3" Condition="'$(Configuration)' == 'Debug'"/>
        <PackageReference Include="Box2D.NET" Version="3.1.654"/>
        <PackageReference Include="MonoGame.Extended" Version="4.0.4"/>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <Compile Remove="**/*.Debug.cs" />
    </ItemGroup>
</Project>