<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\BurningKnight\BurningKnight.csproj"/>
        <ProjectReference Include="..\Lens\Lens.csproj"/>
        <ProjectReference Include="..\Content\Content.csproj" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- Release must run from its output directory alone, and the whole payload travels as one
         archive. A leftover loose tree from an older layout is removed, because it would win over
         the archive; Mods is the player's, so it stays. Debug links to the source tree instead,
         for hot reload. -->
    <Target Name="StageContent" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <MSBuild Projects="..\Content\Content.csproj" Targets="PackContent"
                 Properties="PackOutput=$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '$(OutDir)', 'Content.zip'))" />

        <ItemGroup>
            <RetiredContent Include="$(OutDir)Content\**\*" Exclude="$(OutDir)Content\Mods\**" />
        </ItemGroup>

        <Delete Files="@(RetiredContent)" />
    </Target>
    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*"/>

        <PackageReference Include="MonoGame.Extended" Version="4.0.4"/>
        <PackageReference Include="System.IO.Ports" Version="10.0.12"/>
        <PackageReference Include="Facepunch.Steamworks" Version="2.3.3"/>
        <PackageReference Include="TextCopy" Version="6.2.1"/>
    </ItemGroup>
</Project>
