<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\BurningKnight\BurningKnight.csproj"/>
        <ProjectReference Include="..\Lens\Lens.csproj"/>
        <ProjectReference Include="..\Content\Content.csproj" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- Release must run from its output directory alone. The payload travels as one archive, and
         the music stays loose: a Song can only be opened from a path, not a stream. A leftover
         loose tree from an older layout is removed, because it would win over the archive; Music
         is staged and Mods is the player's, so both stay. Debug links to the source tree instead,
         for hot reload. -->
    <Target Name="StageContent" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <MSBuild Projects="..\Content\Content.csproj" Targets="PackContent"
                 Properties="PackOutput=$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '$(OutDir)', 'Content.zip'))" />

        <ItemGroup>
            <LooseContent Include="..\Content\Music\**\*" />
            <RetiredContent Include="$(OutDir)Content\**\*"
                            Exclude="$(OutDir)Content\Music\**;$(OutDir)Content\Mods\**" />
        </ItemGroup>

        <Delete Files="@(RetiredContent)" />

        <Copy SourceFiles="@(LooseContent)"
              DestinationFiles="@(LooseContent->'$(OutDir)Content\Music\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*"/>

        <PackageReference Include="MonoGame.Extended" Version="4.0.4"/>
        <PackageReference Include="System.IO.Ports" Version="10.0.12"/>
        <PackageReference Include="Facepunch.Steamworks" Version="2.3.3"/>
        <PackageReference Include="TextCopy" Version="6.2.1"/>
    </ItemGroup>
</Project>
